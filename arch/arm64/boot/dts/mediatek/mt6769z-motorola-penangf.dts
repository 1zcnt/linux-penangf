/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/iio/adc/mediatek,mt6370_adc.h>
#include <dt-bindings/usb/pd.h>

#include "mt6769z.dtsi"
#include "mt6358.dtsi"

/ {
	model = "Motorola G13 / G23";
	compatible = "motorola,penangf", "mediatek,mt6769z", "mediatek,mt6768";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * Framebuffer left running by the bootloader. This is the default
		 * display path: taking the pipeline over with the DSI panel driver
		 * (see mt6769z-motorola-penangf-dsi.dts) does not come up reliably yet.
		 */
		framebuffer0: framebuffer@7b250000 {
			compatible = "simple-framebuffer";
			reg = <0 0x7b250000 0 (736*1600*4)>;
			width = <736>;
			height = <1600>;
			stride = <(736 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * No reserved-memory nodes here: the stock bootloader reserves the
	 * framebuffer and pstore regions itself and hangs on purpose if the
	 * device tree already has a node overlapping one of them. ramoops gets
	 * its region from the ramoops.* parameters on the command line instead.
	 */

	/* Downstream: "mediatek,vibrator" with vib_vol = <9>, i.e. VIBR at 2.8 V */
	haptic {
		compatible = "regulator-haptic";
		haptic-supply = <&mt6358_vibr_reg>;
		min-microvolt = <1200000>;
		max-microvolt = <2800000>;
	};
};

/*
 * Volume down. Only KPCOL0 is wired; GPIO92 (KPROW0) is the touch reset here.
 * The controller reports the key as hardware key 1 (the vendor map agrees),
 * which the driver decodes as row 0, column 1.
 */
&keyboard {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&keyboard_pins>;
	linux,keymap = <MATRIX_KEY(0x00, 0x01, KEY_VOLUMEDOWN)>;
	keypad,num-rows = <1>;
	keypad,num-columns = <2>;
	debounce-delay-ms = <32>;
};

/* Power is the default; the PMIC "home" key is volume up on this board. */
&mt6358keys {
	home {
		linux,keycodes = <KEY_VOLUMEUP>;
	};
};

&auxadc {
	status = "okay";
};

&thermal {
	status = "okay";
};

&mt6358_vdram2_reg {
	regulator-always-on;
};

/* mt6358_vaud28_reg - audio */
/* mt6358_vbif28_reg - bluetooth? */

&mt6358_vio28_reg {
	regulator-always-on;
};

// I guess
&mt6358_vaux18_reg {
	regulator-always-on;
};

/*
 * No PSCI idle states. Both cpu-sleep and cluster-sleep are MCDI states that
 * the firmware expects to coordinate with a kernel-side MCDI driver; without
 * one, entering either makes USB transfers stall intermittently (the gadget
 * waits forever for a completion, the host times out after 30 s and resets
 * the device) and once produced a context-tracking WARN on idle entry.
 * WFI only is stable.
 */
&cci {
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu0 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu1 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu2 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu3 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu4 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu5 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu6 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6358_vproc11_reg>;
};

&cpu7 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6358_vproc11_reg>;
};

// For some reason devapc (and others?) make the kernel hang
// at random places and prevents it from booting at all.

/*
 * penangf shipped with four panels (BOE TD4160, Chipone ICNL9916, Ilitek
 * ILI9883A and ILI7807S); the bootloader reports the fitted one in
 * /chosen "atag,videolfb". This describes the BOE TD4160 one; its bias
 * supplies are wired up in mt6769z-motorola-penangf-dsi.dts.
 */
&dsi0 {
	status = "disabled";
	#address-cells = <1>;
	#size-cells = <0>;

	panel: panel@0 {
		compatible = "boe,td4160";
		reg = <0>;
		reset-gpios = <&pio 45 GPIO_ACTIVE_LOW>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&dsi_out {
	remote-endpoint = <&panel_in>;
};

/*
 * The OVL keeps reading the bootloader framebuffer by physical address, so
 * with the M4U enabled every read is an IOMMU fault (an interrupt storm).
 */
&iommu {
	status = "disabled";
};

&gpu {
	status = "okay";
	mali-supply = <&mt6358_vgpu_reg>;
};

&mt6358_vgpu_reg {
	regulator-max-microvolt = <950000>;
	regulator-always-on;
	regulator-boot-on;

	regulator-coupled-with = <&mt6358_vsram_gpu_reg>;
	regulator-coupled-max-spread = <100000>;
};

&mt6358_vsram_gpu_reg {
	regulator-min-microvolt = <850000>;
	regulator-max-microvolt = <1050000>;
	regulator-always-on;
	regulator-boot-on;

	regulator-coupled-with = <&mt6358_vgpu_reg>;
	regulator-coupled-max-spread = <100000>;
};

&mipi_tx0 {
	status = "okay";
};

&mmc0 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_default_pins>;
	pinctrl-1 = <&mmc0_uhs_pins>;
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	cap-mmc-hw-reset;
	no-sdio;
	no-sd;
	non-removable;
	supports-cqe;
	hs400-ds-delay = <0x12814>;
	vmmc-supply = <&mt6358_vemc_reg>;
	vqmmc-supply = <&mt6358_vio18_reg>;
};

&mmc1 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_default_pins>;
	pinctrl-1 = <&mmc1_uhs_pins>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	no-mmc;
	no-sdio;
	cd-gpios = <&pio 18 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6358_vmch_reg>;
	vqmmc-supply = <&mt6358_vmc_reg>;
};

&pio {
	keyboard_pins: keyboard-pins {
		pins {
			pinmux = <PINMUX_GPIO93__FUNC_KPCOL0>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_10>;
			input-enable;
		};
	};

	mmc0_default_pins: mmc0-default-pins {
		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-ds {
			pinmux = <PINMUX_GPIO131__FUNC_MSDC0_DSL>;
			drive-strength = <MTK_DRIVE_4mA>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc0_uhs_pins: mmc0-uhs-pins {
		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-ds {
			pinmux = <PINMUX_GPIO131__FUNC_MSDC0_DSL>;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc1_default_pins: mmc1-default-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO164__FUNC_MSDC1_DAT0>,
				 <PINMUX_GPIO163__FUNC_MSDC1_DAT1>,
				 <PINMUX_GPIO162__FUNC_MSDC1_DAT2>,
				 <PINMUX_GPIO161__FUNC_MSDC1_DAT3>,
				 <PINMUX_GPIO170__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO171__FUNC_MSDC1_CLK>;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-insert {
			pinmux = <PINMUX_GPIO18__FUNC_GPIO18>;
			bias-pull-up;
		};
	};

	mmc1_uhs_pins: mmc1-uhs-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO164__FUNC_MSDC1_DAT0>,
				 <PINMUX_GPIO163__FUNC_MSDC1_DAT1>,
				 <PINMUX_GPIO162__FUNC_MSDC1_DAT2>,
				 <PINMUX_GPIO161__FUNC_MSDC1_DAT3>,
				 <PINMUX_GPIO170__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO171__FUNC_MSDC1_CLK>;
			drive-strength = <MTK_DRIVE_4mA>;
		};
	};
};

&pmic {
	interrupts-extended = <&pio 144 IRQ_TYPE_LEVEL_HIGH>;
};

/* Serial */
&uart0 {
	status = "okay";
};

/* USB */
&usb2 {
	status = "okay";
};

&usb2phy {
	status = "okay";
};
